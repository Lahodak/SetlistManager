@page "/AllSongs"

<PageTitle>All Songs</PageTitle>

<MudContainer Class="mt-5">
    <MudPaper Class="pa-4 mt-3" Elevation="2">
        <MudText Typo="Typo.h3" Class="ml-5">All Songs</MudText>

        @if (_songCollection != null && _songCollection.Any())
        {
            <MudTextField T="string" Label="Search songs" @bind-Value="input" Immediate="true"
                          Class="mt-3" />

            <MudPaper Class="pa-4 mt-3" Elevation="2">
                <MudList T="string">
                    @foreach (var song in _songCollection.Where(s => string.IsNullOrEmpty(input)
                   || s.Name.Contains(input, StringComparison.OrdinalIgnoreCase)
                   || s.Artist.Contains(input, StringComparison.OrdinalIgnoreCase)))
                    {
                        <MudListItem Class="pa-4">
                            <MudLink Href="@($"songdetail/{song.Id}")"
                                     Style="color: black; text-decoration: none; font-size: medium;">
                                @song.Name | @song.Artist
                            </MudLink>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    </MudPaper>
</MudContainer>
