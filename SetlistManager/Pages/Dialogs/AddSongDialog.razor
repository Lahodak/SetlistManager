@using SetlistManager.Common.Models

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h5">Add New Song</MudText>

        <MudPaper Class="pa-4 mt-3" Elevation="2">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_song.Name"
                                  Label="Song Name"
                                  Required="true"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_song.Artist"
                                  Label="Artist"
                                  Required="true"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_song.TabsURL"
                                  Label="Tabs URL"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_song.AudioURL"
                                  Label="Audio URL"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_song.Tuning"
                                  Label="Tuning"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_song.Key"
                                  Label="Key"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_song.BPM"
                                     Label="BPM"
                                     Min="40" Max="300"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_song.Language" Label="Language" Variant="Variant.Outlined">
                        @if(languages is not null)
                        {
                            @foreach(var language in languages)
                            {
                                <MudSelectItem Value="language">@language.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveSong">Save</MudButton>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }
    [Inject]
    public required ISnackbar Snackbar { get; set; }
    [Inject]
    public required SongService SongService { get; set; }
    [Inject]
    public required LanguageService LanguageService { get; set; }
    [Inject]
    public required UserService UserService { get; set; }

    private List<LanguageModel>? languages;

    private SongModel _song = new()
    {
        CreatedAt = DateTime.UtcNow,
        UpdatedAt = DateTime.UtcNow      
    };

    protected override async Task OnInitializedAsync()
    {
        languages = await LanguageService.GetAvailableSetlistAsync();
        _song.Language = languages[0];
        StateHasChanged();
    }

    private async Task SaveSong()
    {
        if (string.IsNullOrWhiteSpace(_song.Name) || string.IsNullOrWhiteSpace(_song.Artist))
        {
            Snackbar.Add("Please provide at least Song Name and Artist.", Severity.Error);
            return;
        }

        try
        {
            await SongService.UploadSongAsync(_song);
            Snackbar.Add("Song added successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_song));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding song: {ex.Message}", Severity.Error);
        }

        var userId = (await UserService.GetUserAsync()).Id;
        _song.LanguageId = _song.Language.Id;
    }

    private void Cancel() => MudDialog.Cancel();
}
