@page "/UserPortal"

<MudText>
	@if(userModel is null)
	{
		<em>Loading...</em>
		return;
	}

	@userModel.Username - @userModel.Email - @userModel.Instrument.Name - @userModel.Id
</MudText>

@code 
{
	[Inject]
	public required UserService _userService { get; set; }
	private UserModel? userModel;

	protected override async Task OnInitializedAsync()
	{
		userModel = await _userService.GetUserAsync();
	}
}
