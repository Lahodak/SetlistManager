@page "/UserPortal"

<MudText>
	@userModel.Username - @userModel.Email - @userModel.Instrument - @userModel.Id
</MudText>

@code 
{
	[Inject]
	public required UserService _userService { get; set; }
	private UserModel userModel = new();

	protected override async Task OnInitializedAsync()
	{
		userModel = await _userService.GetUserAsync() ?? new UserModel();
	}
}
