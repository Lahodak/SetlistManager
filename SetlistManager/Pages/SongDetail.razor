@page "/songdetail/{songId:int}"

<PageTitle>SongDetail</PageTitle>

@if (song != null)
{
    <h1>@song.Name</h1>
    <p>Artist: @song.Artist</p>
    <p>Language: @song.Language</p>
    <p>Tabs: <a href ="@song.Tabs" target="_blank">@song.Tabs</a></p>
    <p>Youtube</p>
    <iframe width="420" height="315"
            src="@song.YouTubeURL">
    </iframe>
    <p>Link: <a href="@song.YouTubeURL" target="_blank">@song.Name by @song.Artist on Youtube</a></p>
    //<p>Lyrics: </p>
    //<p>@GetFormattedLyrics()</p>
}
else
{
    <p>Song not found!</p>
}