@page "/songdetail/{songId:int}"

<PageTitle>SongDetail</PageTitle>

@if (song != null)
{
    <MudText Typo="Typo.h3">@song.Name</MudText>
    <MudText>Artist: @song.Artist</MudText>
    <MudText>Language: @song.Language</MudText>
    <MudText>
        Tabs: <MudLink Href="@song.TabsURL" Target="_blank">View Tabs</MudLink>
    </MudText>
    <MudText>
        Youtube: <MudLink Href="@song.YouTubeURL" Target="_blank">@song.Name by @song.Artist on YouTube</MudLink>
    </MudText>
    <MudText>Lyrics:</MudText>
    <MudText>@GetFormattedLyrics()</MudText>
}
else
{
    <MudText>No song found!</MudText>
}
