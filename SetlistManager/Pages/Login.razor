@page "/login"
@using MudBlazor;
@using SetlistManager.Common.Models;

<MudForm>
    <MudPaper Class="mx-auto mt-12 p-6" Style="max-width:400px;" Elevation="8">
        <MudText Typo="Typo.h5" Class="mb-4">Login</MudText>

        <MudTextField @bind-Value="loginRequestModel.Email" Label="Email" Variant="Variant.Outlined" FullWidth="true" />
        <MudTextField @bind-Value="loginRequestModel.Password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" Class="mt-3" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoginUser" FullWidth="true" Class="mt-4">
            Login
        </MudButton>
    </MudPaper>
</MudForm>

@code {
    [Inject]
    private UserService UserService { get; set; }

    private LoginRequestModel loginRequestModel = new();


    private async Task LoginUser()
    {
        if (loginRequestModel.Password == string.Empty || loginRequestModel.Email == string.Empty)
            return;

        await UserService.LogInAsync(loginRequestModel);        
    }
}
