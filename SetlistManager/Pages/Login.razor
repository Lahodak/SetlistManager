@page "/login"
@using MudBlazor

<MudPaper Class="mx-auto mt-12 p-6" Style="max-width:400px;" Elevation="8">
    <MudText Typo="Typo.h5" Class="mb-4">Login</MudText>

    <MudTextField @bind-Value="Username" Label="Username" Variant="Variant.Outlined" FullWidth="true" />
    <MudTextField @bind-Value="Password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" Class="mt-3" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoginUser" FullWidth="true" Class="mt-4">
        Login
    </MudButton>
</MudPaper>

@code {
    private string Username { get; set; }
    private string Password { get; set; }

    private void LoginUser()
    {
        // Replace with your actual login logic
        if (Username == "admin" && Password == "1234")
        {
            // Success: navigate or show message
            Console.WriteLine("Login successful!");
        }
        else
        {
            // Failed login
            Console.WriteLine("Invalid credentials");
        }
    }
}
