@page "/SetlistsPortal"
@using SetlistManager.Pages.Dialogs

<PageTitle>Setlist Portal</PageTitle>

<MudContainer Class="mt-5">
    <MudPaper Class="pa-4 mt-3" Elevation="2">
        <MudText Typo="Typo.h3" Class="ml-2">Your Setlists</MudText>

        <MudTable ServerData="ServerReload" Hover="true" @ref="table">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Setlist Library</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OpenGenerateDialog()">
                    + New Setlist
                </MudButton>
                <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search setlists"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0 ml-3">
                </MudTextField>
            </ToolBarContent>

            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="name_field" T="SetlistModel">Name</MudTableSortLabel></MudTh>
                <MudTh>Songs</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                
                <MudTd DataLabel="Name">
                    <MudLink Href="@($"setlistdetail/{context.Id}")"
                             Style="color: black; text-decoration: none; font-size: medium;">
                        @context.Name
                    </MudLink>
                </MudTd>

                <MudTd DataLabel="Songs">@context.Songs.Count</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                               OnClick="() => EditSetlist(context.Id)"/>

                    <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Class="ml-2"
                               OnClick="() => DeleteSetlist(context.Id)"/>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No setlists found</MudText>
            </NoRecordsContent>

            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private MudTable<SetlistModel> table;
    private string? searchString;

    [Inject] 
    public required SetlistService SetlistService { get; set; }
    [Inject] 
    public IDialogService DialogService { get; set; }

    private async Task<TableData<SetlistModel>> ServerReload(TableState state, CancellationToken token)
    {
        var allSetlists = await SetlistService.GetAllSetlists();
        await Task.Delay(300, token);

        var filtered = allSetlists.Where(setlist =>
            string.IsNullOrWhiteSpace(searchString)
            || setlist.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)
        );

        filtered = state.SortLabel switch
        {
            "name_field" => filtered.OrderByDirection(state.SortDirection, s => s.Name),
            _ => filtered
        };

        var items = filtered.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();

        return new TableData<SetlistModel>
        {
            TotalItems = filtered.Count(),
            Items = items
        };
    }

    private void OnSearch(string text)
    {
        searchString = text;
        table.ReloadServerData();
    }

    private async Task CreateNewSetlist()
    {
        var parameters = new DialogParameters { ["Setlist"] = new SetlistModel { Id = 0, Songs = new List<SongModel>() } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        var dialog = DialogService.Show<EditSetlistDialog>("New Setlist", parameters, options);

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var setlist = (SetlistModel)result.Data;
            setlist.Id = await SetlistService.PushSetlist(setlist);
            await table.ReloadServerData();
        }
    }

    private async Task EditSetlist(int id)
    {
        var existing = await SetlistService.GetSetlistById(id);
        var parameters = new DialogParameters { ["Setlist"] = existing };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = DialogService.Show<EditSetlistDialog>($"Edit Setlist", parameters, options);

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var updated = (SetlistModel)result.Data;
            await table.ReloadServerData();
        }
    }

    private async Task DeleteSetlist(int id)
    {
        //await SetlistService.DeleteSetlist(id);
        await table.ReloadServerData();
    }

    private async Task OpenGenerateDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateNewSetlistDialog>("",options);

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await table.ReloadServerData();
        }
    }
}