@page "/"

<PageTitle>Home</PageTitle>
<h1>Welcome to Setlist Manager!</h1>

<br />

<button class="btn btn-primary" @onclick="() => _showGenerateSetlistUI = true">Create Setlist</button>
<button class="btn btn-primary" @onclick="() => _showLoadSetlistUI = true">Load Setlist</button>

@if(_showGenerateSetlistUI)
{
    <div>
        How many songs? <input type="number" @bind="_setlistLength" min="1" max="@_maxNumber" />
        <button class="btn btn-primary" @onclick="() => GenerateSetlist()">Generate Setlist</button>

    </div>    
}

@if(_showLoadSetlistUI)
{
    <div>
        Setlist id: <input type="number" @bind="_setlistToBeLoadedId" min="1"/>
        <button class="btn btn-primary" @onclick="() => GetSetlist()">Submit</button>
    </div>
}

@if(_showSaveSetlistUI)
{
    <div>
        Setlist name: <input type="text" @bind="_toBeSavedSetlistName"/>
        <button class="btn btn-primary" @onclick="() => SaveSetlist()">Save Setlist</button>
    </div>
}

<br />
<br />

@if (_shuffeledSongCollection.Count != 0)
{
    <ol>
        @foreach (var song in _shuffeledSongCollection)
        {
            <li class="py-1">
                <button class="btn btn-secondary btn-sm" @onclick="() => RegenerateSong(song.Id)">↺</button>
                <a href="@($"songdetail/{song.Id}")" style="color: black; text-decoration: none; font-size: medium;">@song.Name | @song.Artist</a>
            </li>
        }
    </ol>
}

