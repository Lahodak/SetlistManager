@page "/reset-password"
@layout EmptyLayout

<MudPaper Class="mx-auto mt-12 p-6" Style="max-width:400px;" Elevation="8">
    <MudText Typo="Typo.h5" Class="mb-4">Reset Password</MudText>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudText Color="Color.Error">@_errorMessage</MudText>
    }

    @if (_canReset)
    {
        <MudForm>
            <MudTextField @bind-Value="_newPassword" Label="New Password" InputType="InputType.Password" Required="true" />
            <MudTextField @bind-Value="_confirmPassword" Label="Confirm Password" InputType="InputType.Password" Required="true" />

            <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Disabled="_isSubmitting" OnClick="HandleResetPassword">
                <p>Reset Password</p>
                @if (_isSubmitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mr-2" />
                    <p>Resetting...</p>
                }
            </MudButton>
        </MudForm>
    }
</MudPaper>