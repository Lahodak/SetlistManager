@page "/login"
@layout EmptyLayout;

<MudForm>
    <MudPaper Class="mx-auto mt-12 p-6" Style="max-width:400px;" Elevation="8">
        <MudText Typo="Typo.h5" Class="mb-4">Login</MudText>

        <MudTextField @bind-Value="_loginRequestModel.Email" Label="Email" Variant="Variant.Outlined" FullWidth="true" />
        <MudTextField @bind-Value="_loginRequestModel.Password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" Class="mt-3" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoginUser" FullWidth="true" Class="mt-4">
            Login
        </MudButton>

        <MudText Class="mt-4"> Don't have an account? <MudLink Href="/register">Register here</MudLink> </MudText>

        <MudLink Href="/request-password-reset">Reset password</MudLink>
    </MudPaper>
</MudForm>