@page "/artistdetail/{artistId:int}"

<PageTitle>Artist Detail</PageTitle>

<MudContainer Class="mt-5">
    <MudPaper Class="pa-4" Elevation="2">
        @if (_artist is not null)
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.h4" Class="font-weight-bold">@_artist.Nick</MudText>
            </MudStack>
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Songs by @_artist.Nick</MudText>
                @if (_artist.Songs is not null && _artist.Songs.Count > 0)
                {
                    <MudTable T="SongModel" Items="_artist.Songs" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Language</MudTh>
                            <MudTh>BPM</MudTh>
                            <MudTh>Key</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">
                                <MudLink Href="@($"/songdetail/{context.Id}")" Class="font-weight-medium">
                                    @context.Name
                                </MudLink>
                            </MudTd>
                            <MudTd DataLabel="Language">@context.Language.Code</MudTd>
                            <MudTd DataLabel="BPM">@context.BPM</MudTd>
                            <MudTd DataLabel="Key">@context.Key</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mt-3">No songs by this artist yet.</MudAlert>
                }
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">Artist not found!</MudAlert>
        }
    </MudPaper>
</MudContainer>