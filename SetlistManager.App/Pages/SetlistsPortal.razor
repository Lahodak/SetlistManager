@page "/SetlistsPortal"
<PageTitle>Setlist Portal</PageTitle>

<MudContainer Class="mt-6 mb-8">

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="page-title">Your Setlists Library</MudText>
            <MudText Typo="Typo.body2" Class="page-subtitle">Build and manage your performance setlists</MudText>
        </div>
    </MudStack>

    <MudPaper Class="portal-card" Elevation="0">
        <MudTable ServerData="ServerReload" Hover="true" @ref="table" Class="portal-table">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Class="toolbar-title">Setlist Library</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString"
                              Placeholder="Search setlists..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="search-field"
                              Immediate="true"
                              DebounceInterval="700"
                              OnDebounceIntervalElapsed="OnSearch" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="() => OpenGenerateDialog()"
                           StartIcon="@Icons.Material.Filled.Add"
                           Class="ml-3 add-btn">
                    New Setlist
                </MudButton>
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="name_field" T="SetlistModel">Name</MudTableSortLabel></MudTh>
                <MudTh>Songs</MudTh>
                <MudTh Style="width: 160px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    <MudLink Href="@($"setlistdetail/{context.Id}")" Class="row-link">
                        @context.Name
                    </MudLink>
                </MudTd>
                <MudTd DataLabel="Songs">@context.Songs.Count</MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (context.Owner.Id == _userId)
                        {
                            <MudTooltip Text="Share setlist">
                                <MudIconButton OnClick="() => AddAccessToUserAsync(context.Id)"
                                               Icon="@Icons.Material.Filled.PersonAddAlt1"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               Color="Color.Secondary" />
                            </MudTooltip>
                            <MudTooltip Text="Edit setlist">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="() => EditSetlist(context.Id)" />
                            </MudTooltip>
                            <MudTooltip Text="Delete setlist">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="() => DeleteSetlist(context)" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Remove from library">
                                <MudIconButton OnClick="() => RemoveSetlistFromUserLibrary(context)"
                                               Icon="@Icons.Material.Filled.PersonRemoveAlt1"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               Color="Color.Error" />
                            </MudTooltip>
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.QueueMusic" Class="empty-icon" />
                    <MudText Typo="Typo.body1" Class="empty-title">No setlists found</MudText>
                    <MudText Typo="Typo.body2" Class="empty-subtitle">Try adjusting your search or create a new setlist</MudText>
                </div>
            </NoRecordsContent>
            <LoadingContent>
                <div class="loading-state">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Class="ml-3">Loading setlists...</MudText>
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>