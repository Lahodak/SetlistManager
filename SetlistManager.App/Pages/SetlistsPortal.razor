@page "/SetlistsPortal"

<PageTitle>Setlist Portal</PageTitle>

<MudContainer Class="mt-5">
    <MudPaper Class="pa-4 mt-3" Elevation="2">
        <MudText Typo="Typo.h3" Class="ml-2">Your Setlists Library</MudText>

        <MudTable ServerData="ServerReload" Hover="true" @ref="table">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Setlist Library</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OpenGenerateDialog()">
                    + New Setlist
                </MudButton>
                <MudTextField @bind-Value="searchString"
                              Placeholder="Search setlists"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0 ml-4"
                              Immediate="true"
                              DebounceInterval="700"
                              OnDebounceIntervalElapsed="OnSearch" />
            </ToolBarContent>

            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="name_field" T="SetlistModel">Name</MudTableSortLabel></MudTh>
                <MudTh>Songs</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                
                <MudTd DataLabel="Name">
                    <MudLink Href="@($"setlistdetail/{context.Id}")"
                             Style="color: black; text-decoration: none; font-size: medium;">
                        @context.Name
                    </MudLink>
                </MudTd>

                <MudTd DataLabel="Songs">@context.Songs.Count</MudTd>
                <MudTd DataLabel="Actions">

                    @if(context.Owner.Id == _userId)
                    {
                        <MudIconButton OnClick="() => AddAccessToUserAsync(context.Id)" Icon="@Icons.Material.Filled.PersonAddAlt1" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" Class="ml-2" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                       OnClick="() => EditSetlist(context.Id)" />


                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Class="ml-2"
                                       OnClick="() => DeleteSetlist(context)" />
                    }
                    else
                    {                                        
                        <MudIconButton OnClick="() => RemoveSetlistFromUserLibrary(context)" Icon="@Icons.Material.Filled.PersonRemoveAlt1" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Class="ml-2" />                        
                    }

                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No setlists found</MudText>
            </NoRecordsContent>

            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>