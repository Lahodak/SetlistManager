<MudDialog>
    <DialogContent>
        <MudPaper Class="pa-4 mt-3" Elevation="2">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_songModel.Name"
                                  Label="Song Name"
                                  Required="true"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="ArtistModel"
                                     Label="Artist"
                                     Variant="Variant.Outlined"
                                     SearchFunc="SearchArtists"
                                     ToStringFunc="@(a => a == null ? null : a.Nick)"
                                     ValueChanged="OnArtistSelected"
                                     Value="_songModel.Artist"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     Required="true"
                                     DebounceInterval="700" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_songModel.TabsURL"
                                  Label="Tabs URL"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_songModel.AudioURL"
                                  Label="Audio URL"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_songModel.Tuning"
                                  Label="Tuning"
                                  Variant="Variant.Outlined"
                                  Placeholder="e.g., E Standard, Drop D" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_songModel.Key"
                                  Label="Key"
                                  Variant="Variant.Outlined"
                                  Placeholder="e.g., C, Am, G" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_songModel.BPM"
                                     Label="BPM"
                                     Min="40"
                                     Max="300"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="LanguageModel"
                                     Label="Language"
                                     Variant="Variant.Outlined"
                                     SearchFunc="SearchLanguages"
                                     ToStringFunc="@(l => l == null ? null : l.Name)"
                                     ValueChanged="OnLanguageSelected"
                                     Value="_songModel.Language"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     Required="true"
                                     DebounceInterval="700" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool"
                                 @bind-Value="_songModel.IsPublic"
                                 Color="Color.Primary"
                                 Label="Make song public (visible to others)" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveAsync">
            Save
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>