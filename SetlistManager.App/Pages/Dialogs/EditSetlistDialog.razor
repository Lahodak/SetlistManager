<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_setlist.Name" Label="Setlist Name" Class="mt-3" />

        <MudList T="SongModel">
            @foreach (var song in _setlist.Songs)
            {
                <MudListItem>
                    <MudText>@song.Name (@song.Artist.Nick)</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" OnClick="() => MoveSongUp(song)" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" OnClick="() => MoveSongDown(song)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => RemoveSong(song)" />
                </MudListItem>
            }
        </MudList>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">
            + Add Song
        </MudButton>
    </DialogContent>

    <DialogActions>
        <MudIconButton Icon="@Icons.Material.Filled.SaveAs" Variant="Variant.Filled" Color="Color.Success" OnClick="Save">Save</MudIconButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel" Class="ml-2">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>