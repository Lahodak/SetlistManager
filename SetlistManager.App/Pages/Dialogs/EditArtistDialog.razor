<MudDialog>
    <DialogContent>
        <MudPaper Class="pa-4 mt-3" Elevation="2">
            <MudGrid>
                <MudItem>
                    <MudTextField @bind-Value="_artistUpdateModel!.Nick" Style="width: 200px; height: 50px;" HelperText="Nick" Required="true"/>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton Class="pa-2 ml-2" Variant="Variant.Outlined" Style="height: 50px;"
                   OnClick="() => SaveAsync()">
            Save
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>