<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h5">Create new Artist</MudText>

            <MudPaper Class="pa-4 mt-3" Elevation="2">
                <MudText Typo="Typo.body1">Add new Artist:</MudText>
                <MudGrid>
                    <MudItem>
                        <MudTextField @bind-Value="_artistModel.Nick" Style="width: 200px; height: 50px;" />
                    </MudItem>
                </MudGrid>
            </MudPaper>        
    </DialogContent>

    <DialogActions>
            <MudButton Class="pa-2 ml-2" Variant="Variant.Outlined" Style="height: 50px;"
                       OnClick="() => Save()">
                Create Artist
            </MudButton>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>