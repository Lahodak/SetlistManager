<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h5">Generate New Setlist</MudText>
        <MudPaper Class="pa-4 mt-3" Elevation="2">
            <MudGrid>
                <MudItem>
                    <MudNumericField @bind-Value="_length"
                                     Min="1" Max="@_maxNumber"
                                     Label="Number of Songs"
                                     Variant="Variant.Outlined"
                                     /> 
                </MudItem>
                <MudItem>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Generate" >
                        Generate
                    </MudButton>

                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_showSaveSetlistUI)
        {
            <MudPaper Class="pa-4 mt-3" Elevation="2">
                <MudText Typo="Typo.body1">Setlist Name:</MudText>
                <MudGrid>
                    <MudItem>
                        <MudTextField @bind-Value="_toBeSavedSetlistName" Style="width: 200px; height: 50px;" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        @if (_shuffeledSongCollection.Count != 0 && _showSetlistContentUI)
        {
            <MudPaper Class="pa-4 mt-4" Elevation="2">
                <MudList T="string">
                    @foreach (var song in _shuffeledSongCollection)
                    {
                        <MudListItem>
                            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Variant="Variant.Outlined" Class="pa-2 ml-2" OnClick="() => RegenerateSong(song.Id)"/>
                                
                            <MudLink Href="@($"songdetail/{song.Id}")"
                                     Style="color: black; text-decoration: none; font-size: medium;">
                                @song.Name | @song.Artist
                            </MudLink>

                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }

    </DialogContent>

    <DialogActions>

        @if (_showSaveSetlistUI)
        {
            <MudButton Class="pa-2 ml-2" Variant="Variant.Outlined" Style="height: 50px;"
                       OnClick="() => Save()">
                Save Setlist
            </MudButton>
        }

        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>