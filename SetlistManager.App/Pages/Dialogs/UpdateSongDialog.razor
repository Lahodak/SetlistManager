<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h5">Update Song</MudText>

        @if (Song is not null)
        {
            <MudPaper Class="pa-4 mt-3" Elevation="2">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Song.Name"
                                      Label="Song Name"
                                      Required="true"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="Song.Artist" Label="Artist" Variant="Variant.Outlined">
                            @if (_artists is not null)
                            {
                                @foreach (var artist in _artists)
                                {
                                    <MudSelectItem Value="artist">@artist.Nick</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Song.TabsURL"
                                      Label="Tabs URL"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Song.AudioURL"
                                      Label="Audio URL"
                                      Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Song.Tuning"
                                      Label="Tuning"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Song.Key"
                                      Label="Key"
                                      Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="Song.BPM"
                                         Label="BPM"
                                         Min="40" Max="300"
                                         Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect @bind-Value="Song.Language" Label="Language" Variant="Variant.Outlined">
                            @if (_languages is not null)
                            {
                                @foreach (var language in _languages)
                                {
                                    <MudSelectItem Value="language">@language.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
        else
        {
            <MudProgressCircular Indeterminate="true"/>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="Song is null"> Save </MudButton>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>