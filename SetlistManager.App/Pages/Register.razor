@page "/register"
@layout EmptyLayout;

<div class="auth-wrapper">

    <MudIconButton Href="/login"
                   Icon="@Icons.Material.Filled.ArrowBack"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Class="auth-back-btn" />

    <MudPaper Class="auth-card" Elevation="0">

        <div class="auth-header">
            <div class="auth-logo-wrap">
                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="auth-logo-icon" />
            </div>
            <MudText Typo="Typo.h5" Class="auth-title">Create an account</MudText>
            <MudText Typo="Typo.body2" Class="auth-subtitle">Fill in your details to get started</MudText>
        </div>

        <MudForm Class="auth-form">
            <MudTextField @bind-Value="_registerRequestModel.Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Class="auth-field" />

            <MudTextField @bind-Value="_registerRequestModel.UserName"
                          Label="Username"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Class="auth-field" />

            <MudTextField @bind-Value="_registerRequestModel.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword? InputType.Text: InputType.Password)"
                          FullWidth="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          Class="auth-field" />

            <MudTextField @bind-Value="confirmPassword"
                          Label="Confirm Password"
                          Variant="Variant.Outlined"
                          InputType="@(InputType.Password)"
                          FullWidth="true"
                          Adornment="Adornment.End"
                          Class="auth-field" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="LoginUser"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="auth-btn mt-2">
                Register
            </MudButton>
        </MudForm>

        <MudDivider Class="auth-divider" />

        <div class="auth-footer">
            <MudText Typo="Typo.body2" Class="auth-footer-text">
                Already have an account?
                <MudLink Href="/login" Class="auth-link">Sign in here</MudLink>
            </MudText>
        </div>

    </MudPaper>
</div>