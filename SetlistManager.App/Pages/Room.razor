@page "/room/{RoomCode}"
@layout EmptyLayout

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0" Style="position: relative;">
    <MudAppBar Elevation="0" Dense="true" Style="height: 56px;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="font-weight: 500;">@(_roomModel?.Name ?? "Loading...")</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="d-none d-sm-flex">@(_user?.Username ?? "")</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" Anchor="Anchor.Start" Elevation="2" Variant="DrawerVariant.Temporary">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Room Controls</MudText>
        </MudDrawerHeader>
        <MudDivider />
        <MudList Clickable="true" T="object">
            <MudListItem>
                <MudText Typo="Typo.subtitle2" Class="mb-2">View Mode</MudText>
                <MudSelect T="ViewMode"
                           Value="@_currentViewMode"
                           ValueChanged="OnViewModeChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           FullWidth="true">
                    <MudSelectItem Value="ViewMode.SongAndSetlist">Song + Setlist</MudSelectItem>
                    <MudSelectItem Value="ViewMode.SongAndLyrics">Song + Lyrics</MudSelectItem>
                    <MudSelectItem Value="ViewMode.SongAndTabs">Song + Tabs</MudSelectItem>
                    <MudSelectItem Value="ViewMode.LyricsAndSetlist">Lyrics + Setlist</MudSelectItem>
                    <MudSelectItem Value="ViewMode.TabsAndSetlist">Tabs + Setlist</MudSelectItem>
                    <MudSelectItem Value="ViewMode.LyricsAndTabs">Lyrics + Tabs</MudSelectItem>
                    <MudSelectItem Value="ViewMode.SongOnly">Song Only</MudSelectItem>
                    <MudSelectItem Value="ViewMode.LyricsOnly">Lyrics Only</MudSelectItem>
                    <MudSelectItem Value="ViewMode.TabsOnly">Tabs Only</MudSelectItem>
                    <MudSelectItem Value="ViewMode.SetlistOnly">Setlist Only</MudSelectItem>
                </MudSelect>
            </MudListItem>
            <MudDivider Class="my-2" />
            <MudListItem>
                <div class="d-flex align-center justify-space-between">
                    <MudText Typo="Typo.body2">Room Code:</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@RoomCode</MudText>
                </div>
            </MudListItem>
            <MudListItem OnClick="OpenQrCodeDialog">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.QrCode" Class="mr-3" />
                    <MudText>Show QR Code</MudText>
                </div>
            </MudListItem>
            <MudListItem OnClick="ToggleFullscreen">
                <div class="d-flex align-center">
                    <MudIcon Icon="@(_isFullscreen? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Class="mr-3" />
                    <MudText>@(_isFullscreen ? "Exit Fullscreen" : "Enter Fullscreen")</MudText>
                </div>
            </MudListItem>
            <MudDivider Class="my-2" />
            <MudListItem>
                <MudText Typo="Typo.body2" Class="mb-2">User Info</MudText>
                <MudText Typo="Typo.caption">@(_user?.Username ?? "Loading...")</MudText>
                <MudText Typo="Typo.caption">@(_user?.Instrument?.Name ?? "Loading...")</MudText>
            </MudListItem>
        </MudList>
    </MudDrawer>

    <MudContainer MaxWidth="MaxWidth.False" Class="pa-0" Style="height: calc(100vh - 56px); overflow: hidden;">
        @if (_roomModel is null || _currentSong == null)
        {
            <div class="d-flex align-center justify-center" style="height: 100%;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            </div>
        }
        else
        {
            @if (_currentViewMode == ViewMode.SongAndSetlist)
            {
                <MudGrid Spacing="0" Style="height: 100%; margin: 0;">
                    <MudItem xs="12" md="6" Style="height: 100%; padding: 12px;">
                        @RenderSongInfo()
                    </MudItem>
                    <MudItem xs="12" md="6" Style="height: 100%; padding: 12px;">
                        @RenderSetlist()
                    </MudItem>
                </MudGrid>
            }
            else if (_currentViewMode == ViewMode.SongAndLyrics)
            {
                <MudGrid Spacing="0" Style="height: 100%; margin: 0;">
                    <MudItem xs="12" md="5" Style="height: 100%; padding: 12px;">
                        @RenderSongInfo()
                    </MudItem>
                    <MudItem xs="12" md="7" Style="height: 100%; padding: 12px;">
                        @RenderLyrics()
                    </MudItem>
                </MudGrid>
            }
            else if (_currentViewMode == ViewMode.SongAndTabs)
            {
                <MudGrid Spacing="0" Style="height: 100%; margin: 0;">
                    <MudItem xs="12" md="5" Style="height: 100%; padding: 12px;">
                        @RenderSongInfo()
                    </MudItem>
                    <MudItem xs="12" md="7" Style="height: 100%; padding: 12px;">
                        @RenderTabs()
                    </MudItem>
                </MudGrid>
            }
            else if (_currentViewMode == ViewMode.LyricsAndSetlist)
            {
                <MudGrid Spacing="0" Style="height: 100%; margin: 0;">
                    <MudItem xs="12" md="7" Style="height: 100%; padding: 12px;">
                        @RenderLyrics()
                    </MudItem>
                    <MudItem xs="12" md="5" Style="height: 100%; padding: 12px;">
                        @RenderSetlist()
                    </MudItem>
                </MudGrid>
            }
            else if (_currentViewMode == ViewMode.TabsAndSetlist)
            {
                <MudGrid Spacing="0" Style="height: 100%; margin: 0;">
                    <MudItem xs="12" md="7" Style="height: 100%; padding: 12px;">
                        @RenderTabs()
                    </MudItem>
                    <MudItem xs="12" md="5" Style="height: 100%; padding: 12px;">
                        @RenderSetlist()
                    </MudItem>
                </MudGrid>
            }
            else if (_currentViewMode == ViewMode.LyricsAndTabs)
            {
                <MudGrid Spacing="0" Style="height: 100%; margin: 0;">
                    <MudItem xs="12" md="6" Style="height: 100%; padding: 12px;">
                        @RenderLyrics()
                    </MudItem>
                    <MudItem xs="12" md="6" Style="height: 100%; padding: 12px;">
                        @RenderTabs()
                    </MudItem>
                </MudGrid>
            }
            else if (_currentViewMode == ViewMode.SongOnly)
            {
                <div style="height: 100%; padding: 12px; display: flex; align-items: center; justify-content: center;">
                    <div style="max-width: 800px; width: 100%;">
                        @RenderSongInfo()
                    </div>
                </div>
            }
            else if (_currentViewMode == ViewMode.LyricsOnly)
            {
                <div style="height: 100%; padding: 12px;">
                    @RenderLyrics()
                </div>
            }
            else if (_currentViewMode == ViewMode.TabsOnly)
            {
                <div style="height: 100%; padding: 12px;">
                    @RenderTabs()
                </div>
            }
            else if (_currentViewMode == ViewMode.SetlistOnly)
            {
                <div style="height: 100%; padding: 12px; display: flex; align-items: center; justify-content: center;">
                    <div style="max-width: 600px; width: 100%;">
                        @RenderSetlist()
                    </div>
                </div>
            }
        }
    </MudContainer>

    @if (_currentSong != null && _roomModel?.Setlist?.Songs != null)
    {
        <div class="fab-container">
            <MudFab Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.ArrowBack"
                    Size="Size.Medium"
                    OnClick="MoveToPrevSong"
                    Style="margin-right: 8px;"
                    Disabled="@(!CanMoveToPrevSong())" />
            <MudFab Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.ArrowForward"
                    Size="Size.Medium"
                    OnClick="MoveToNextSong"
                    Disabled="@(!CanMoveToNextSong())" />
        </div>
    }
</MudContainer>

@code {
    private RenderFragment RenderSongInfo() => __builder =>
    {
        <MudPaper Elevation="2" Class="pa-6" Style="height: 100%; border-radius: 12px; overflow-y: auto;">
            <MudText Typo="Typo.h3" Style="font-weight: 700; word-break: break-word; line-height: 1.2;" Class="mb-3">
                @_currentSong.Name
            </MudText>
            <MudText Typo="Typo.h5" Class="mb-4" Style="opacity: 0.8;">
                @(_currentSong.Artist?.Nick ?? "N/A")
            </MudText>

            <MudDivider Class="my-4" />

            <div class="d-flex flex-wrap gap-3">
                <MudPaper Elevation="1" Class="pa-4 flex-grow-1" Style="min-width: 120px; border-radius: 8px;">
                    <MudText Typo="Typo.caption" Color="Color.Default">BPM</MudText>
                    <MudText Typo="Typo.h5" Style="font-weight: 600;">@_currentSong.BPM</MudText>
                </MudPaper>
                <MudPaper Elevation="1" Class="pa-4 flex-grow-1" Style="min-width: 120px; border-radius: 8px;">
                    <MudText Typo="Typo.caption" Color="Color.Default">Key</MudText>
                    <MudText Typo="Typo.h5" Style="font-weight: 600;">@_currentSong.Key</MudText>
                </MudPaper>
                <MudPaper Elevation="1" Class="pa-4 flex-grow-1" Style="min-width: 120px; border-radius: 8px;">
                    <MudText Typo="Typo.caption" Color="Color.Default">Tuning</MudText>
                    <MudText Typo="Typo.h5" Style="font-weight: 600;">@_currentSong.Tuning</MudText>
                </MudPaper>
            </div>

            @if (!string.IsNullOrEmpty(_currentSong.TabsURL))
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Href="@_currentSong.TabsURL"
                           Target="_blank"
                           FullWidth="true"
                           Class="mt-4"
                           StartIcon="@Icons.Material.Filled.LibraryMusic">
                    View Tabs
                </MudButton>
            }

            @if (!string.IsNullOrEmpty(_currentSong.AudioURL))
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           Href="@_currentSong.AudioURL"
                           Target="_blank"
                           FullWidth="true"
                           Class="mt-2"
                           StartIcon="@Icons.Custom.Brands.YouTube">
                    Watch on YouTube
                </MudButton>
            }
        </MudPaper>
    };

    private RenderFragment RenderSetlist() => __builder =>
    {
        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%; border-radius: 12px; display: flex; flex-direction: column;">
            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">Setlist</MudText>
            <div id="setlist-container" style="flex: 1; overflow-y: auto; overflow-x: hidden;">
                @if (_roomModel?.Setlist?.Songs != null)
                {
                    @foreach (var song in _roomModel.Setlist.Songs.OrderBy(s => s.Order))
                    {
                        var isCurrentSong = song.Id == _currentSong.Id;
                        var cardClass = $"pa-4 mb-3 {(isCurrentSong ? "current-song-card" : "hover-card")}";
                        var cardStyle = $"border-radius: 10px; cursor: pointer; transition: all 0.25s ease; {(isCurrentSong ? "background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%); color: white;" : "")}";

                        <MudPaper Elevation="@(isCurrentSong ? 4 : 1)"
                                  Class="@cardClass"
                                  Style="@cardStyle"
                                  @onclick="@(() => SelectSong(song))">
                            <MudText Typo="Typo.subtitle1" Style="@(isCurrentSong ? "color: white; font-weight: 600;" : "font-weight: 500;")">
                                @song.Name
                            </MudText>
                            <MudText Typo="Typo.body2" Style="@(isCurrentSong ? "color: rgba(255,255,255,0.9);" : "opacity: 0.7;")">
                                @(song.Artist?.Nick ?? "N/A")
                            </MudText>
                        </MudPaper>
                    }
                }
            </div>
        </MudPaper>
    };

    private RenderFragment RenderLyrics() => __builder =>
    {
        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%; border-radius: 12px; display: flex; flex-direction: column;">
            <div class="d-flex justify-space-between align-center mb-3 flex-wrap gap-2">
                <MudText Typo="Typo.h6" Style="font-weight: 600;">Lyrics</MudText>
                <MudToggleGroup T="double"
                                Value="@_fontScale"
                                ValueChanged="OnFontScaleChanged"
                                Outlined="true"
                                Delimiters="true"
                                CheckMark="false"
                                FixedContent="true"
                                Size="Size.Small">
                    <MudToggleItem Value="1.0">Standard</MudToggleItem>
                    <MudToggleItem Value="2.0">Large</MudToggleItem>
                </MudToggleGroup>
            </div>

            <div class="d-flex align-center gap-2 mb-3 flex-wrap">
                @if (!_isScrolling)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                   Color="Color.Success"
                                   OnClick="@(() => ToggleScroll(true))"
                                   Variant="Variant.Filled"
                                   Size="Size.Small" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Stop"
                                   Color="Color.Error"
                                   OnClick="@(() => ToggleScroll(false))"
                                   Variant="Variant.Filled"
                                   Size="Size.Small" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                               Color="Color.Default"
                               OnClick="ResetScroll"
                               Variant="Variant.Outlined"
                               Size="Size.Small" />
                <div style="flex: 1; min-width: 150px;">
                    <MudSlider T="int"
                               Value="@_scrollSpeed"
                               ValueChanged="OnSpeedChanged"
                               Min="1"
                               Max="100"
                               Step="1"
                               Color="Color.Info"
                               Size="Size.Small">
                        Speed: @_scrollSpeed
                    </MudSlider>
                </div>
            </div>

            @if (_lyricsData is not null)
            {
                <div id="genius-lyrics-container"
                     style="flex: 1; overflow-y: auto; overflow-x: hidden; border-radius: 8px; --lyrics-zoom: @_fontScale;">
                </div>
            }
            else if (_isLoadingLyrics)
            {
                <div class="d-flex align-center justify-center" style="flex: 1;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">No lyrics available for this song.</MudAlert>
            }
        </MudPaper>
    };

    private RenderFragment RenderTabs() => __builder =>
    {
        <MudPaper Elevation="2" Class="pa-4" Style="height: 100%; border-radius: 12px; display: flex; flex-direction: column;">
            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">Tabs</MudText>

            @if (!string.IsNullOrEmpty(_currentSong.TabsURL))
            {
                var embeddableUrl = ConvertToEmbeddableTabsUrl(_currentSong.TabsURL);
                <iframe src="@embeddableUrl"
                        style="flex: 1; width: 100%; border: none; border-radius: 8px;"
                        title="Song Tabs"
                        allowfullscreen>
                </iframe>
            }
            else
            {
                <div class="d-flex align-center justify-center" style="flex: 1;">
                    <MudAlert Severity="Severity.Info">No tabs available for this song.</MudAlert>
                </div>
            }
        </MudPaper>
    };
}

<style>
    .fab-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        display: flex;
        z-index: 1000;
    }

    .hover-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15) !important;
    }

    .current-song-card {
        scroll-margin-top: 0px;
    }

    #setlist-container::-webkit-scrollbar {
        width: 6px;
    }

    #setlist-container::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.05);
        border-radius: 3px;
    }

    #setlist-container::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.2);
        border-radius: 3px;
    }

        #setlist-container::-webkit-scrollbar-thumb:hover {
            background: rgba(0,0,0,0.3);
        }

    #genius-lyrics-container .rg_embed {
        transform: scale(var(--lyrics-zoom, 1.0)) !important;
        transform-origin: top center !important;
        width: calc(100% / var(--lyrics-zoom, 1.0)) !important;
        margin: 0 auto !important;
        display: block !important;
        background: transparent !important;
    }

    #genius-lyrics-container .rg_embed_body,
    #genius-lyrics-container .rg_embed_body div,
    #genius-lyrics-container .rg_embed_body p,
    #genius-lyrics-container .lyrics,
    #genius-lyrics-container .lyrics p {
        color: var(--mud-palette-text-primary) !important;
        background-color: transparent !important;
    }

        #genius-lyrics-container .rg_embed_body a {
            color: var(--mud-palette-text-primary) !important;
            text-decoration: none !important;
        }

    #genius-lyrics-container .rg_embed_header,
    #genius-lyrics-container .rg_embed_footer {
        background: transparent !important;
        color: var(--mud-palette-text-secondary) !important;
        border: none !important;
    }

    #genius-lyrics-container::-webkit-scrollbar {
        width: 6px;
    }

    #genius-lyrics-container::-webkit-scrollbar-track {
        background: transparent;
    }

    #genius-lyrics-container::-webkit-scrollbar-thumb {
        background: var(--mud-palette-lines-inputs);
        border-radius: 10px;
    }

        #genius-lyrics-container::-webkit-scrollbar-thumb:hover {
            background: var(--mud-palette-text-secondary);
        }

    @@media (max-width: 959px) {
        .fab-container {
            bottom: 16px;
            right: 16px;
        }
    }
</style>