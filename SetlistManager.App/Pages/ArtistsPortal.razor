@page "/ArtistsPortal"

<PageTitle>Artists Portal</PageTitle>

<MudContainer Class="mt-5">
    <MudPaper Class="pa-4 mt-3" Elevation="2">
        <MudText Typo="Typo.h3" Class="ml-2">Your Artists Library</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.Public" Href="/PublicArtists" Color="Color.Primary"> Go to public artists</MudButton>
        <MudTable ServerData="ServerReload" Hover="true" @ref="_table">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Artist Library</MudText>
                <MudSpacer />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateArtistDialog" StartIcon="@Icons.Material.Filled.Add">
                    Add Artist
                </MudButton>

                <MudTextField @bind-Value="searchString"
                              Placeholder="Search artists"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" 
                              Class="mt-0 ml-4"
                              Immediate="true"
                              DebounceInterval="700"
                              OnDebounceIntervalElapsed="OnSearch" />

            </ToolBarContent>

            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="nick_field" T="ArtistModel">Nick</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="songs_field" T="ArtistModel">Songs Count</MudTableSortLabel></MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Nick">
                    <MudLink Href="@($"artistdetail/{context.Id}")"
                             Style="color: black; text-decoration: none; font-size: medium;">
                        @context.Nick
                    </MudLink>
                </MudTd>
                <MudTd DataLabel="Songs Count">@(context.Songs?.Count ?? 0)</MudTd>
                <MudTd DataLabel="Actions">
                    @if(context.OwnerId == _userId)
                    {                        
                        <MudIconButton OnClick="() => AddAccessToUserAsync(context.Id)" Icon="@Icons.Material.Filled.PersonAddAlt1" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" Class="ml-2" />
                        
                        if (!context.IsPublic)
                        {
                            <MudIconButton OnClick="() => MakeArtistPublicAsync(context)" Icon="@Icons.Material.Filled.Public" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Tertiary" />
                            <MudIconButton OnClick="() => UpdateArtistAsync(context)" Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" />
                            <MudIconButton OnClick="() => DeleteArtistAsync(context)" Icon="@Icons.Material.Filled.DeleteForever" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Class="ml-2" />
                        }                        
                    }
                    else
                    {
					    <MudIconButton OnClick="() => RemoveArtistFromLibraryAsync(context)" Icon="@Icons.Material.Filled.PersonRemoveAlt1" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" Class="ml-2" />
                    }
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No matching records found</MudText>
            </NoRecordsContent>

            <LoadingContent>
                <MudText>Loading...</MudText>
            </LoadingContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>