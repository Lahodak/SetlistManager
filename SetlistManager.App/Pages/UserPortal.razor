@page "/UserPortal"

@if (_userModel is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" />    
}
else
{    
    <MudCard Class=" max-w-md p-6 shadow-lg rounded-2xl justify-content-center">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-4 font-semibold text-center">
                User Profile
            </MudText>

            <MudTextField @bind-Value="_userModel.Username" Label="Username" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_userModel.Email" Label="Email" Variant="Variant.Outlined" Class="mb-3" />

            <MudSelect T="InstrumentModel" @bind-Value="_userModel.Instrument" Label="Instrument" Variant="Variant.Outlined" Class="mb-3">
                @if (_instruments is not null)
                {
                    @foreach (var instrument in _instruments)
                    {
                        <MudSelectItem Value="@instrument">@instrument.Name</MudSelectItem>
                    }
                }
            </MudSelect>
            @if(_userModel.Tokens!.Count == 0)
            {
                <MudButton Variant="Variant.Outlined" OnClick="AuthorizeWithGenius">
                    Authorize with Genius  <MudImage Src="GENIUS_Logo_Transparent.png" Width="20" Height="20" />
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-2">
                    Connected to Genius <MudImage Src="GENIUS_Logo_Transparent.png" Width="20" Height="20" />
                </MudText>
			}
        </MudCardContent>

        <MudCardActions>
            <MudButton Class="me-3"OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled">
                Save
            </MudButton>
            <MudButton OnClick="LogOutAsync" Color="Color.Error" Variant="Variant.Filled">
                Logout
            </MudButton>
        </MudCardActions>
    </MudCard>    
}