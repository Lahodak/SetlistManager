@page "/UserPortal"

@if (_userModel is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" />    
}
else
{    
    <MudCard Class=" max-w-md p-6 shadow-lg rounded-2xl justify-content-center">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-4 font-semibold text-center">
                User Profile
            </MudText>

            <MudTextField @bind-Value="_userModel.Username" Label="Username" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_userModel.Email" Label="Email" Variant="Variant.Outlined" Class="mb-3" />

            <MudSelect T="InstrumentModel" @bind-Value="_userModel.Instrument" Label="Instrument" Variant="Variant.Outlined" Class="mb-3">
                @if (instruments is not null)
                {
                    @foreach (var instrument in instruments)
                    {
                        <MudSelectItem Value="@instrument">@instrument.Name</MudSelectItem>
                    }
                }
            </MudSelect>
            @if(_userModel.Tokens is null)
            {
                <MudButton Variant="Variant.Outlined">
                    Authorize with Genius  <MudImage Src="GENIUS_Logo_Transparent.png" Width="20" Height="20" />
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-2">
                    Connected to Genius <MudImage Src="GENIUS_Logo_Transparent.png" Width="20" Height="20" />
                </MudText>
			}
        </MudCardContent>

        <MudCardActions>
            <MudButton Class="me-3"OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled">
                Save
            </MudButton>
            <MudButton OnClick="LogOutAsync" Color="Color.Error" Variant="Variant.Filled">
                Logout
            </MudButton>
        </MudCardActions>
    </MudCard>    
}

@code
{
    [Inject]
    public required UserService UserService { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }
    [Inject]
    public required InstrumentService InstrumentService { get; set; }
    [Inject]
	public required GeniusService GeniusService { get; set; }
    private UserModel? _userModel;
    private List<InstrumentModel>? instruments;
    private string _authorizeWithGeniusUri = default!;

    protected override async Task OnInitializedAsync()
    {
        _userModel = await UserService.GetUserAsync();
        instruments = await InstrumentService.GetAvailableInstrumentsAsync();

        if (_userModel?.Instrument != null)
        {
            _userModel.Instrument = instruments.FirstOrDefault(i => i.Id == _userModel.Instrument.Id)!;
        }
		_authorizeWithGeniusUri = GeniusService.GetGrantAccessTokenRequestUri();
    }

    private async Task SaveAsync()
    {
        if (_userModel is not null)
        {
            await UserService.UpdateUser(_userModel);
            NavigationManager.Refresh(true);
        }
    }

    private async Task LogOutAsync()
    {
        await UserService.LogOutAsync();
        NavigationManager.NavigateTo("/login");
    }
}