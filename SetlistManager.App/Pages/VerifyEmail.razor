@page "/verify-email"
@layout EmptyLayout

<MudPaper Class="mx-auto mt-12 p-6" Style="max-width:400px;" Elevation="8">
    <MudText Typo="Typo.h5" Class="mb-4">Verify Email</MudText>

    @if (isVerifying)
    {
        <MudProgressCircular Indeterminate="true" />
        <MudText>Verifying your email...</MudText>
    }
    else if (successMessage != null)
    {
        <MudText Color="Color.Success">@successMessage</MudText>
    }
    else if (errorMessage != null)
    {
        <MudText Color="Color.Error">@errorMessage</MudText>
    }
</MudPaper>