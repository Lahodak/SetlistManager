@page "/publicsongs"
@using SetlistManager.App.Services
@using SetlistManager.Common.Models

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="page-title">Public Songs</MudText>
            <MudText Typo="Typo.body2" Class="page-subtitle">Browse and add songs from the community library</MudText>
        </div>
        <MudButton StartIcon="@Icons.Material.Filled.LibraryMusic"
                   Href="/songsportal"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Class="back-btn">
            Your Library
        </MudButton>
    </MudStack>

    <MudPaper Class="portal-card" Elevation="0">
        <MudTable @ref="table"
                  ServerData="ServerReload"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Loading="@_loading"
                  LoadingProgressColor="Color.Primary"
                  Class="portal-table">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Class="toolbar-title">Song Library</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString"
                              Placeholder="Search songs..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="search-field"
                              Immediate="true"
                              DebounceInterval="700"
                              OnDebounceIntervalElapsed="OnSearch" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="title_field" T="SongModel">Title</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="artist_field" T="SongModel">Artist</MudTableSortLabel></MudTh>
                <MudTh Style="width: 100px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">
                    <MudText Typo="Typo.body2" Class="row-text">@context.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Artist">
                    <MudText Typo="Typo.body2" Class="row-text">@context.Artist!.Nick</MudText>
                </MudTd>
                <MudTd DataLabel="Actions">
                    @if (_userSongIds.Contains(context.Id))
                    {
                        <MudTooltip Text="Already in your library">
                            <MudIconButton Icon="@Icons.Material.Filled.LibraryAddCheck"
                                           Color="Color.Success"
                                           Variant="Variant.Text"
                                           Size="Size.Small" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="Add to your library">
                            <MudIconButton Icon="@Icons.Material.Filled.LibraryAdd"
                                           Color="Color.Primary"
                                           Variant="Variant.Text"
                                           Size="Size.Small"
                                           OnClick="@(() => AddToLibrary(context))" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.MusicOff" Class="empty-icon" />
                    <MudText Typo="Typo.body1" Class="empty-title">No songs found</MudText>
                    <MudText Typo="Typo.body2" Class="empty-subtitle">Try adjusting your search</MudText>
                </div>
            </NoRecordsContent>
            <LoadingContent>
                <div class="loading-state">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Class="ml-3">Loading songs...</MudText>
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>