@page "/RoomsPortal"
@using MudBlazor
@using SetlistManager.App.Pages.Dialogs
@using SetlistManager.App.Services.Implementations
@using SetlistManager.Common.Models

<PageTitle>Rooms Portal</PageTitle>

<MudContainer>
    <MudPaper>

        <MudGrid Justify="Justify.SpaceEvenly" Class="mt-6">
            <MudItem>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="CreateRoomClicked">
                    Create Room
                </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Large"
                           OnClick="OpenJoinRoomDialog">
                    Join Room
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudTable ServerData="ServerReload" Hover="true" @ref="table">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Browse Public Rooms</MudText>
                <MudSpacer />
                <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search rooms"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0 ml-3">
                </MudTextField>
            </ToolBarContent>

            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="name_field" T="RoomModel">Name</MudTableSortLabel></MudTh>
                <MudTh>Public</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Public">@context.IsPublic</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               OnClick="() => JoinSelectedRoom(context)">
                        Join
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No public rooms found</MudText>
            </NoRecordsContent>

            <LoadingContent>
                <MudText>Loading rooms...</MudText>
            </LoadingContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    [Inject]
    public required IDialogService DialogService { get; set; }
    [Inject]
    public required IRoomService RoomService { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    private MudTable<RoomModel> table = new();
    private string? searchString;

    private async Task<TableData<RoomModel>> ServerReload(TableState state, CancellationToken token)
    {
        var allRooms = await RoomService.GetPublicActiveRoomsAsync() ?? [];

        await Task.Delay(300, token);

        var filtered = allRooms.Where(room =>
            string.IsNullOrWhiteSpace(searchString)
            || room.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase)
        );

        filtered = state.SortLabel switch
        {
            "name_field" => filtered.OrderByDirection(state.SortDirection, r => r.Name),
            _ => filtered
        };

        var items = filtered.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray();

        return new TableData<RoomModel>
        {
            TotalItems = filtered.Count(),
            Items = items
        };
    }

    private void OnSearch(string text)
    {
        searchString = text;
        table.ReloadServerData();
    }

    private async Task CreateRoomClicked()
    {
        var options = new DialogOptions { CloseButton = true };
        var dialog = await DialogService.ShowAsync<CreateRoomDialog>("Create New Room", options);

        var result = await dialog.Result;
        if (!result!.Canceled)
        {
            await table.ReloadServerData();
        }
    }

    private async Task OpenJoinRoomDialog()
    {
        var options = new DialogOptions { CloseButton = true };
        var dialog = await DialogService.ShowAsync<JoinRoomDialog>("Join Room", options);
        var result = await dialog.Result;
    }

    private void JoinSelectedRoom(RoomModel room)
    {
		NavigationManager.NavigateTo($"/room/{room.Code}");
    }
}