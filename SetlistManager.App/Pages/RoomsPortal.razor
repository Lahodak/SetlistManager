@page "/RoomsPortal"

<PageTitle>Rooms Portal</PageTitle>

<MudContainer>
    <MudPaper>

        <MudGrid Justify="Justify.SpaceEvenly" Class="mt-6">
            <MudItem>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="CreateRoomClicked">
                    Create Room
                </MudButton>
            </MudItem>
            <MudItem>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Large"
                           OnClick="OpenJoinRoomDialog">
                    Join Room
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudTable ServerData="ServerReload" Hover="true" @ref="table">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Browse Public Rooms</MudText>
                <MudSpacer />
                <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search rooms"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0 ml-3">
                </MudTextField>
            </ToolBarContent>

            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="name_field" T="RoomModel">Name</MudTableSortLabel></MudTh>
                <MudTh>Public</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Name">@context?.Name</MudTd>
                <MudTd DataLabel="Public">@context?.IsPublic</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               OnClick="() => JoinSelectedRoom(context!)">
                        Join
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No public rooms found</MudText>
            </NoRecordsContent>

            <LoadingContent>
                <MudText>Loading rooms...</MudText>
            </LoadingContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>