@page "/songdetail/{songId:int}"

<PageTitle>Song Detail</PageTitle>

<MudContainer Class="mt-5">
    <MudPaper Class="pa-4 mt-3" Elevation="2">
        @if (song != null)
        {
            <MudText Typo="Typo.h3" Class="ml-2">@song.Name</MudText>

            <MudPaper Class="pa-4 mt-3" Elevation="2">
                <MudText Typo="Typo.body1" Class="mt-2">Artist: <b>@song.Artist</b></MudText>
                <MudText Typo="Typo.body1" Class="mt-2">Language: <b>@song.Language.Code</b></MudText>

                <MudText Typo="Typo.body1" Class="mt-2">
                    Tabs:
                    <MudLink Href="@song.TabsURL" Target="_blank" Class="ml-1">
                        View Tabs
                    </MudLink>
                </MudText>

                <MudText Typo="Typo.body1" Class="mt-2">
                    YouTube:
                    <MudLink Href="@song.AudioURL" Target="_blank" Class="ml-1">
                        Watch on YouTube
                    </MudLink>
                </MudText>                                                   
            </MudPaper>

            @if (song.Language.Code == "EN")
            {
                <MudPaper Class="pa-4 mt-3" Elevation="2">
                    <MudText Typo="Typo.h6">Lyrics:</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">
                        @GetFormattedLyrics()
                    </MudText>
                </MudPaper>
            }
        }
        else
        {
            <MudAlert Severity="MudBlazor.Severity.Warning" Class="mt-3">
                Song not found!
            </MudAlert>
        }
    </MudPaper>
</MudContainer>