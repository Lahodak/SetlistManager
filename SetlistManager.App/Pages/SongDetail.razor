@page "/songdetail/{SongId:int}"
<PageTitle>Song Detail</PageTitle>
<MudContainer Class="mt-5">
    <MudPaper Class="pa-4 mt-3" Elevation="2">
        @if (_song != null)
        {
            <MudText Typo="Typo.h3" Class="ml-2">@_song.Name</MudText>
            <MudPaper Class="pa-4 mt-3" Elevation="2">
                <MudText Typo="Typo.body1" Class="mt-2">Artist: <b>@_song.Artist!.Nick</b></MudText>
                <MudText Typo="Typo.body1" Class="mt-2">Language: <b>@_song.Language.Code</b></MudText>
                <MudText Typo="Typo.body1" Class="mt-2">
                    Tabs:
                    <MudLink Href="@_song.TabsURL" Target="_blank" Class="ml-1">
                        View Tabs
                    </MudLink>
                </MudText>
                <MudText Typo="Typo.body1" Class="mt-2">
                    YouTube:
                    <MudLink Href="@_song.AudioURL" Target="_blank" Class="ml-1">
                        Watch on YouTube
                    </MudLink>
                </MudText>
            </MudPaper>
            <MudPaper Class="pa-4 mt-3" Elevation="2">
                <MudText Typo="Typo.h6">Lyrics:</MudText>
                @if (_lyricsData is not null)
                {
                    <div id="genius-lyrics-container"></div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mt-2">No lyrics available</MudText>
                }
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="MudBlazor.Severity.Warning" Class="mt-3">
                Song not found!
            </MudAlert>
        }
    </MudPaper>
</MudContainer>