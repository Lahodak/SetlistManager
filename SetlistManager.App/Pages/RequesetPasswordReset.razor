@page "/request-password-reset"
@layout EmptyLayout

<div class="auth-wrapper">

    <MudIconButton Href="/login"
                   Icon="@Icons.Material.Filled.ArrowBack"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Class="auth-back-btn" />

    <MudPaper Class="auth-card" Elevation="0">

        <div class="auth-header">
            <div class="auth-logo-wrap">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="auth-logo-icon" />
            </div>
            <MudText Typo="Typo.h5" Class="auth-title">Forgot your password?</MudText>
            <MudText Typo="Typo.body2" Class="auth-subtitle">Enter your email and we'll send you a reset link</MudText>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="auth-alert-wrap">
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true">@successMessage</MudAlert>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-alert-wrap">
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true">@errorMessage</MudAlert>
            </div>
        }

        <MudForm Class="auth-form">
            <MudTextField @bind-Value="email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Class="auth-field" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="HandlePasswordResetRequest"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="isSubmitting"
                       Class="auth-btn mt-2">
                @if (isSubmitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    <span>Sending...</span>
                }
                else
                {
                    <span>Send Reset Link</span>
                }
            </MudButton>
        </MudForm>

        <MudDivider Class="auth-divider" />

        <div class="auth-footer">
            <MudText Typo="Typo.body2" Class="auth-footer-text">
                Remembered your password?
                <MudLink Href="/login" Class="auth-link">Sign in here</MudLink>
            </MudText>
        </div>

    </MudPaper>
</div>