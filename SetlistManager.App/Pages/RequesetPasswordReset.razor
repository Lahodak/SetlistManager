@page "/request-password-reset"
@layout EmptyLayout

<MudPaper Class="mx-auto mt-12 p-6" Style="max-width:400px;" Elevation="8">
    <MudText Typo="Typo.h5" Class="mb-4">Reset Password</MudText>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <MudText Color="Color.Success">@successMessage</MudText>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudText Color="Color.Error">@errorMessage</MudText>
    }

    <MudForm>
        <MudTextField @bind-Value="email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Required="true"
                      InputType="InputType.Email" />

        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Disabled="isSubmitting" OnClick="HandlePasswordResetRequest">
                @if (isSubmitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mr-2" />
                    <p>Resetting...</p>
                }
                else
                {
                    <p>
                        Reset Password
                    </p>                    
                }
            </MudButton>
    </MudForm>
</MudPaper>